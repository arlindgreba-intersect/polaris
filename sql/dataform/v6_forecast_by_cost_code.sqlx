config {
  type: "incremental",
  schema: "stg_finance",
  name: "v6_forecast_by_cost_code",
  description: "Most-detailed incremental forecast aggregation rolled up to the account code grain.",
  bigquery: {
    partitionBy: "forecast_date",
    clusterBy: ["run_id", "technology", "acct_code"]
  }
}

-- The code below unpivots horizontal period columns into vertical forecast_date rows
-- and appends new runs dynamically when the Apps Script executes.
WITH unpivoted_forecast AS (
  SELECT
    run_id,
    run_label,
    run_type,
    project_id,
    technology,
    acct_code,
    -- Convert column names like 'period_2028_04_30' to a true DATE type
    PARSE_DATE('period_%Y_%m_%d', period_col) AS forecast_date,
    monthly_spend_usd
  FROM
    `sandbox-lakehouse.polaris_raw.v6_raw_forecast_inputs`
  UNPIVOT(
    monthly_spend_usd FOR period_col IN (
      
      -- 130 month-end columns from raw schema (2020-09-30 through 2031-06-30)
      period_2020_09_30, period_2020_10_31, period_2020_11_30, period_2020_12_31, period_2021_01_31, period_2021_02_28, period_2021_03_31, period_2021_04_30, period_2021_05_31, period_2021_06_30, period_2021_07_31, period_2021_08_31,
      period_2021_09_30, period_2021_10_31, period_2021_11_30, period_2021_12_31, period_2022_01_31, period_2022_02_28, period_2022_03_31, period_2022_04_30, period_2022_05_31, period_2022_06_30, period_2022_07_31, period_2022_08_31,
      period_2022_09_30, period_2022_10_31, period_2022_11_30, period_2022_12_31, period_2023_01_31, period_2023_02_28, period_2023_03_31, period_2023_04_30, period_2023_05_31, period_2023_06_30, period_2023_07_31, period_2023_08_31,
      period_2023_09_30, period_2023_10_31, period_2023_11_30, period_2023_12_31, period_2024_01_31, period_2024_02_29, period_2024_03_31, period_2024_04_30, period_2024_05_31, period_2024_06_30, period_2024_07_31, period_2024_08_31,
      period_2024_09_30, period_2024_10_31, period_2024_11_30, period_2024_12_31, period_2025_01_31, period_2025_02_28, period_2025_03_31, period_2025_04_30, period_2025_05_31, period_2025_06_30, period_2025_07_31, period_2025_08_31,
      period_2025_09_30, period_2025_10_31, period_2025_11_30, period_2025_12_31, period_2026_01_31, period_2026_02_28, period_2026_03_31, period_2026_04_30, period_2026_05_31, period_2026_06_30, period_2026_07_31, period_2026_08_31,
      period_2026_09_30, period_2026_10_31, period_2026_11_30, period_2026_12_31, period_2027_01_31, period_2027_02_28, period_2027_03_31, period_2027_04_30, period_2027_05_31, period_2027_06_30, period_2027_07_31, period_2027_08_31,
      period_2027_09_30, period_2027_10_31, period_2027_11_30, period_2027_12_31, period_2028_01_31, period_2028_02_29, period_2028_03_31, period_2028_04_30, period_2028_05_31, period_2028_06_30, period_2028_07_31, period_2028_08_31,
      period_2028_09_30, period_2028_10_31, period_2028_11_30, period_2028_12_31, period_2029_01_31, period_2029_02_28, period_2029_03_31, period_2029_04_30, period_2029_05_31, period_2029_06_30, period_2029_07_31, period_2029_08_31,
      period_2029_09_30, period_2029_10_31, period_2029_11_30, period_2029_12_31, period_2030_01_31, period_2030_02_28, period_2030_03_31, period_2030_04_30, period_2030_05_31, period_2030_06_30, period_2030_07_31, period_2030_08_31,
      period_2030_09_30, period_2030_10_31, period_2030_11_30, period_2030_12_31, period_2031_01_31, period_2031_02_28, period_2031_03_31, period_2031_04_30, period_2031_05_31, period_2031_06_30
    
    )
  )
  WHERE
    monthly_spend_usd IS NOT NULL 
    AND monthly_spend_usd != 0
    -- If running incrementally, only process run_ids that aren't already in this destination table
    ${when(incremental(), `AND run_id NOT IN (SELECT DISTINCT run_id FROM ${self()})`)}
)

SELECT
  run_id,
  run_label,
  run_type,
  project_id,
  technology,
  acct_code,
  forecast_date,
  SUM(monthly_spend_usd) AS monthly_spend_usd,
  COUNT(*)                AS source_line_count
FROM
  unpivoted_forecast
GROUP BY
  run_id,
  run_label,
  run_type,
  project_id,
  technology,
  acct_code,
  forecast_date